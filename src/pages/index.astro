---
import '../styles/global.css';
import TopicLinks from '../components/TopicLinks.astro';

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ogImageUrl = Astro.site ? new URL('/images/og-cover.png', Astro.site).toString() : undefined;

const mapUrl = 'https://maps.app.goo.gl/3t2apWjTJbkW2L4x5';
const photoHero = '/images/parque-san-pio-bucaramanga-garden.jpg';
const photoBotero = 'https://bucketlist2life.com/_ipx/f_webp/blogposts/bucaramanga-travel-guide/pio.jpg';
const photoPlay = 'https://i0.wp.com/www.emisoracultural.gov.co/wp-content/uploads/2023/03/PARQUE-SAN-PIO.jpeg?fit=1024%2C684&ssl=1';
const photoNight = 'https://www.bucaramanga.gov.co/wp-content/uploads/2022/09/iluminacion-parque-san-pio.jpg';

const placeSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Park', 'Place'],
  '@id': `${canonicalUrl}#park`,
  name: 'Parque Guillermo Sorzano (Parque San Pío)',
  alternateName: ['Parque San Pío', 'Saint Pío Park'],
  description: 'Parque urbano de Cabecera del Llano, Bucaramanga, conocido por su arbolado, senderos de ladrillo y la escultura Mujer de pie, desnuda de Fernando Botero.',
  ...(canonicalUrl ? { url: canonicalUrl } : {}),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bucaramanga',
    addressRegion: 'Santander',
    addressCountry: 'CO'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 7.1185637,
    longitude: -73.1104339
  },
  image: [photoBotero, photoPlay, photoNight],
  sameAs: [mapUrl]
};

const faqItems = [
  {
    q: '¿La entrada al Parque San Pío tiene costo?',
    a: 'Las fuentes describen un parque público, no un recinto con boletería. No se verificó una tarifa municipal vigente para actividades o servicios: confirma cualquier cobro anunciado y las condiciones del evento antes de pagar.'
  },
  {q: '¿Dónde queda el Parque San Pío y es lo mismo que la iglesia?', a: 'El parque está en Cabecera del Llano, Bucaramanga. Maps lista Cra. 33 #45 como referencia; no verificamos un número de puerta ni una entrada exacta. Confirma el acceso antes de salir. La parroquia San Pío X es otro destino: el mapa de esta guía corresponde al parque, no a horarios de misas ni servicios parroquiales.'},
  {q: '¿El Parque San Pío abre las 24 horas?', a: 'Google Maps mostraba acceso de 24 horas el 29 de octubre de 2026; Santander Travel también publica ese horario. Es una referencia del espacio público, no una garantía de acceso a cada zona, juego, servicio o evento. Consulta avisos y cierres locales antes de salir.'},
  {
    q: '¿Cuál es el mejor momento para visitarlo?',
    a: 'La mañana y el final de la tarde suelen ser agradables por la sombra, la luz y el ambiente del sector. Si vas de noche, usa las precauciones habituales de una zona urbana.'
  },
  {
    q: '¿Cuánto tiempo conviene quedarse?',
    a: 'Como propuesta editorial, reserva 45–90 minutos para un paseo pausado; adapta el tiempo a las zonas abiertas, tu movilidad y el clima. No es una duración oficial ni una garantía de disponibilidad de obras o servicios.'
  },
  {
    q: '¿Hay parqueadero dentro del parque?',
    a: 'Esta guía no verifica parqueadero propio ni disponibilidad de operadores cercanos. Busca un estacionamiento autorizado y confirma dirección de entrada, tarifa, horario y cupo antes de llegar.'
  },
  {
    q: '¿Qué obra de Fernando Botero está en San Pío?',
    a: 'La escultura se titula “Mujer de pie, desnuda”. Es una de las piezas de arte público más reconocibles de Bucaramanga y fue instalada en 2010 y declarada bien de interés cultural municipal en 2013, según el IMCT.'
  },
  {
    q: '¿Se puede llegar en transporte público?',
    a: 'Sí. Cabecera es un sector bien conectado de Bucaramanga. Las rutas pueden cambiar, así que lo más fiable es consultar una app de transporte local con destino “Parque San Pío” antes de salir.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonicalUrl}#faq`,
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#123f33" />
    <meta name="description" content="Parque San Pío en Bucaramanga: ubicación en Cabecera, cómo llegar, fotos, la escultura de Botero y planes alrededor. Verifica acceso, parqueadero y servicios." />
    <title>Parque San Pío Bucaramanga: Ubicación, Fotos y Cómo Llegar</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <link rel="alternate" hreflang="es-CO" href={canonicalUrl} />}
    {canonicalUrl && <link rel="alternate" hreflang="x-default" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content="Parque San Pío Bucaramanga: Ubicación, Fotos y Cómo Llegar" />
    <meta property="og:description" content="Ubicación en Cabecera, cómo llegar, arte público de Botero y consejos para verificar acceso, parqueadero y servicios antes de ir." />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta property="og:image:alt" content="Composición gráfica de hojas y senderos, no fotografía del parque" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Parque San Pío Bucaramanga: Ubicación, Fotos y Cómo Llegar" />
    <meta name="twitter:description" content="Ubicación, arte público y guías de la visita; referencias para verificar acceso y servicios antes de ir." />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <meta name="twitter:image:alt" content="Composición gráfica de hojas y senderos, no fotografía del parque" />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(placeSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="#inicio" aria-label="Parque San Pío, inicio">
          <img src="/icons/logo.svg" alt="Parque San Pío · Bucaramanga" width="420" height="104" />
        </a>
        <nav class="nav" aria-label="Navegación principal">
          <a href="#descubrir">Descubrir</a>
          <a href="#visita">Planear visita</a>
          <a href="#alrededores">Alrededores</a>
          <a href="#guias">Guías</a>
          <a href="#faq">Preguntas</a>
          <a class="map-link" href={mapUrl} target="_blank" rel="noreferrer">Abrir mapa ↗</a>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <section class="hero" id="inicio">
        <div class="hero-grid">
          <div>
            <div class="kicker">Cabecera · Bucaramanga</div>
            <h1>Parque San Pío en<br />Bucaramanga.</h1>
            <p class="hero-lede">Un parque para caminar bajo árboles maduros, encontrarse con arte de Fernando Botero y sentir el pulso cotidiano de Cabecera del Llano.</p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="#visita">Planear la visita</a>
              <a class="btn btn-secondary" href={mapUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
            </div>
            <div class="hero-facts" aria-label="Datos rápidos">
              <span>Google Maps · ★ 4,5 · 16.003 reseñas · 29/10/2026</span>
              <span>Acceso: verifica avisos locales</span>
              <span>45–90 min · propuesta editorial</span>
              <span>Maps: Cra. 33 #45 · referencia; confirma la entrada</span>
            </div>
          </div>
          <figure class="hero-photo">
            <img src={photoHero} alt="Senderos de ladrillo y árboles maduros en el Parque San Pío, Bucaramanga" width="640" height="400" fetchpriority="high" />
            <figcaption>Fotografía del Parque San Pío: senderos de ladrillo y arbolado en Cabecera del Llano.</figcaption>
          </figure>
        </div>
      </section>

      <section class="section" id="fotografias" aria-labelledby="fotografias-title">
        <div class="wrap">
          <div class="section-heading">
            <div>
              <div class="kicker">Fotografías</div>
              <h2 id="fotografias-title">El parque en imágenes.</h2>
            </div>
            <p>Imágenes del Parque San Pío y de la escultura de Botero en Cabecera del Llano.</p>
          </div>
          <div class="photo-composition" aria-label="Fotografías del Parque San Pío">
            <div class="leaf-orbit" aria-hidden="true"></div>
            <figure class="photo-main">
              <img src={photoBotero} alt="Escultura Mujer de pie, desnuda de Fernando Botero en el Parque San Pío" width="1200" height="900" loading="eager" referrerpolicy="no-referrer" />
            </figure>
            <figure class="photo-small">
              <img src={photoPlay} alt="Zona verde y juegos infantiles entre árboles del Parque San Pío" width="1024" height="684" loading="lazy" referrerpolicy="no-referrer" />
            </figure>
            <div class="botero-badge">Arte público<br />+ ciudad jardín</div>
          </div>
        </div>
      </section>

      <section class="gallery-band" aria-label="Galería del parque">
        <div class="wrap gallery-grid">
          <figure>
            <img src={photoNight} alt="Vista nocturna iluminada del Parque San Pío" width="1600" height="900" loading="lazy" referrerpolicy="no-referrer" />
            <figcaption>Iluminación del parque</figcaption>
          </figure>
          <figure>
            <img src="/images/parque-san-pio-botero-sculpture.jpg" alt="Escultura de Botero en el Parque San Pío" loading="lazy" />
            <figcaption>Escultura de Botero</figcaption>
          </figure>
          <figure>
            <img src="/images/mujer-de-pie-desnuda-bucaramanga-side.jpg" alt="Vista lateral de la escultura Mujer de pie, desnuda" loading="lazy" />
            <figcaption>Vista lateral de la escultura</figcaption>
          </figure>
          <figure>
            <img src="/images/san-pio-botero-monument.jpg" alt="Monumento de Botero en San Pío" loading="lazy" />
            <figcaption>Monumento de Botero</figcaption>
          </figure>
          <figure>
            <img src="/images/parque-san-pio-bucaramanga-garden.jpg" alt="Zona verde del Parque San Pío" loading="lazy" />
            <figcaption>Zona verde del parque</figcaption>
          </figure>
          <figure>
            <img src="/images/parque-san-pio-botero-old-view.jpg" alt="Vista anterior del Parque San Pío y la escultura" loading="lazy" />
            <figcaption>Vista anterior del parque</figcaption>
          </figure>
        </div>
      </section>

      <section class="section identity" id="descubrir">
        <div class="wrap">
          <div class="section-heading">
            <div>
              <div class="kicker" style="color:var(--gold)">La identidad del parque</div>
              <h2>Donde el verde conversa con el bronce.</h2>
            </div>
            <p>El Área Metropolitana de Bucaramanga identifica este espacio como Parque Guillermo Sorzano González, conocido como San Pío. Esta guía trata del parque de Cabecera, no de la parroquia del mismo nombre.</p>
          </div>
          <div class="story-grid">
            <article class="story-feature">
              <div class="number">2010</div>
              <h3>Botero en el espacio cotidiano</h3>
              <p>Ese año el municipio incorporó la escultura <em>Mujer de pie, desnuda</em>, de Fernando Botero. La pieza se volvió un punto de referencia visual y cultural del parque y ha recibido intervenciones de conservación patrimonial.</p>
            </article>
            <div class="story-stack">
              <article class="story-card">
                <h3>Más jardín, menos prisa</h3>
                <p>Una intervención de paisajismo reportada por la Alcaldía incluyó la siembra de más de 3.000 plantas ornamentales y el mejoramiento del entorno de la escultura de mariposa donada por Mario Hernández.</p>
              </article>
              <article class="story-card">
                <h3>Senderos para volver a caminar</h3>
                <p>Las publicaciones municipales documentan intervenciones en senderos, iluminación y mobiliario. Son antecedentes de mantenimiento, no una certificación del estado actual de cada instalación; respeta cierres y señalización.</p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="visita">
        <div class="wrap">
          <div class="section-heading">
            <div>
              <div class="kicker">Antes de salir</div>
              <h2>Una visita sencilla de organizar.</h2>
            </div>
            <p>San Pío funciona mejor como una pausa dentro de un recorrido por Cabecera: combina el parque con una comida, café o paseo por las calles comerciales cercanas.</p>
          </div>
          <div class="visit-grid">
            <article class="visit-item">
              <div class="icon" aria-hidden="true">◌</div>
              <h3>Entrada / costo</h3>
              <p>Es un parque público. No se verificó una tarifa municipal vigente para actividades o servicios; confirma cualquier cobro anunciado y sus condiciones antes de pagar.</p>
            </article>
            <article class="visit-item">
              <div class="icon" aria-hidden="true">☀</div>
              <h3>Mejor momento</h3>
              <p>Mañana o final de la tarde para aprovechar sombra, luz suave y movimiento del sector sin el sol más intenso.</p>
            </article>
            <article class="visit-item">
              <div class="icon" aria-hidden="true">⌁</div>
              <h3>Tiempo sugerido</h3>
              <p>Propuesta editorial: 45–90 minutos para una pausa tranquila, ajustando el recorrido al clima y a las zonas abiertas.</p>
            </article>
            <article class="visit-item">
              <div class="icon" aria-hidden="true">24</div>
              <h3>Acceso</h3>
              <p>Maps mostraba 24 horas el 29 de octubre de 2026; Santander Travel también lo publica. No garantiza apertura de todas las zonas, juegos o servicios: mantenimiento y eventos pueden imponer cierres.</p>
            </article>
          </div>
          <p class="note"><strong>Consejo local:</strong> Bucaramanga tiene clima cálido; lleva agua y protección solar aunque el parque sea sombreado. Para la noche, aplica las precauciones normales de cualquier espacio público urbano.</p>
        </div>
      </section>


      <section class="section" id="movilidad">
        <div class="wrap">
          <div class="section-heading">
            <div>
              <div class="kicker">Movilidad</div>
              <h2>Llegar, caminar, estacionar.</h2>
            </div>
            <p>El parque está en Cabecera del Llano, entre corredores urbanos activos. La forma más cómoda depende de dónde comiences tu recorrido y de la hora.</p>
          </div>
          <div class="info-split">
            <article class="info-panel">
              <h3>Cómo llegar</h3>
              <ul>
                <li><strong>A pie:</strong> una buena opción si ya estás en Cabecera; las cuadras cercanas concentran comercio, restaurantes y cafés.</li>
                <li><strong>Taxi o app:</strong> busca “Parque San Pío” y confirma el punto de llegada. Maps lista Cra. 33 #45 como referencia, no como entrada exacta verificada por esta guía.</li>
                <li><strong>Bus:</strong> el sector cuenta con transporte urbano; consulta la ruta vigente el mismo día porque recorridos y paradas pueden cambiar.</li>
                <li><strong>Bicicleta:</strong> llega con precaución por vías urbanas y asegura la bicicleta únicamente en un punto permitido.</li>
              </ul>
            </article>
            <article class="info-panel">
              <h3>Parqueadero</h3>
              <ul>
                <li>El parque en sí no es un estacionamiento.</li>
                <li>Busca un estacionamiento autorizado y comprueba su entrada, tarifa y horario; esta guía no confirma operadores, cupos ni parqueadero propio del parque.</li>
                <li>No se publican aquí tarifas exactas porque cambian con frecuencia: confirma precio, horario y cupo al llegar.</li>
                <li>Evita dejar objetos visibles dentro del vehículo y respeta las restricciones de estacionamiento en vía.</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section class="section map-section" id="mapa">
        <div class="wrap map-shell">
          <div class="map-copy">
            <div class="kicker">Ubicación y dirección</div>
            <h2>En el corazón de Cabecera.</h2>
            <address>Cabecera del Llano<br />Bucaramanga, Santander, Colombia</address>
            <p>Referencia listada en Google Maps: Cra. 33 #45. No es un número de puerta ni una entrada exacta verificados por esta guía; confirma el acceso antes de viajar.</p>
            <p class="coords">7.1185637, −73.1104339 · punto de referencia</p>
            <a class="btn btn-primary" href={mapUrl} target="_blank" rel="noreferrer">Abrir en Google Maps ↗</a>
          </div>
          <div class="map-frame">
            <iframe
              src="https://maps.google.com/maps?q=7.1185637,-73.1104339&amp;hl=es&amp;z=17&amp;output=embed"
              title="Mapa de Parque San Pío, Bucaramanga"
              loading="lazy"
              allowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"></iframe>
          </div>
        </div>
      </section>

      <section class="section" id="alrededores">
        <div class="wrap">
          <div class="section-heading">
            <div>
              <div class="kicker">Alrededores</div>
              <h2>Comer bien y seguir caminando.</h2>
            </div>
            <p>Cabecera permite convertir una visita corta al parque en una tarde completa. Estas opciones están en el entorno del sector; verifica horarios y disponibilidad antes de ir.</p>
          </div>
          <div class="info-split">
            <article class="info-panel"><h3>Elige la sucursal antes de caminar</h3><p>El portal Santander Travel menciona restaurantes y centros comerciales en el entorno. Busca el negocio concreto en su página oficial y confirma dirección, servicio y horario; no asumimos que una marca tenga una sucursal junto al parque.</p></article>
            <article class="info-panel"><h3>Parque e iglesia son destinos distintos</h3><p>Esta guía corresponde al espacio público de San Pío, también llamado Guillermo Sorzano. Si buscas la parroquia San Pío X, confirma directamente su dirección y agenda: el mapa del parque no verifica misas ni atención parroquial.</p></article>
          </div>
        </div>
      </section>

      <TopicLinks />

      <section class="section faq" id="faq">
        <div class="wrap">
          <div class="section-heading">
            <div>
              <div class="kicker" style="color:var(--gold)">FAQ</div>
              <h2>Preguntas antes de ir.</h2>
            </div>
            <p>Respuestas breves para planear sin sobrecargar la visita. Cuando un dato operativo puede cambiar, conviene confirmarlo el mismo día.</p>
          </div>
          <div>
            {faqItems.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section id="fuentes" class="section sources" aria-labelledby="fuentes-title">
        <div class="wrap">
          <h2 id="fuentes-title" style="font-size:2.2rem;color:var(--forest-deep)">Fuentes y criterio editorial</h2>
          <p>Revisión de fuentes: 29 de octubre de 2026. Google Maps mostraba 4,5/5 de 16.003 reseñas; son opiniones de terceros, no reseñas recopiladas por esta guía. La información cultural y de mejoras del parque se contrastó con publicaciones de la Alcaldía de Bucaramanga y del Instituto Municipal de Cultura y Turismo. Los datos operativos de comercios, transporte y parqueaderos cambian con mayor frecuencia; por eso esta guía evita fijar tarifas, rutas u horarios de terceros que puedan quedar obsoletos.</p>
          <p>
            <a href="https://www.bucaramanga.gov.co/noticias/parque-san-pio-respira-un-nuevo-aire/" target="_blank" rel="noreferrer">Paisajismo y recuperación del Parque San Pío ↗</a><br />
            <a href="https://imct.gov.co/se-inicia-la-restauracion-de-la-escultura-mujer-de-pie-desnuda-en-el-parque-san-pio/" target="_blank" rel="noreferrer">Conservación de “Mujer de pie, desnuda” ↗</a><br />
            <a href="https://www.bucaramanga.gov.co/noticias/el-parque-san-pio-se-reabre-por-completo-asi-lo-disfrutan-de-nuevo-los-bumangueses/" target="_blank" rel="noreferrer">Senderos, iluminación y espacio público ↗</a>
          </p>
          <p><a href="https://www.santander.travel/planes-13-m/15-escultura-la-mujer-de-pie-desnuda-o-gorda-de-botero.htm" target="_blank" rel="noreferrer">Santander Travel · ubicación de la escultura y horario publicado ↗</a><br /><a href="https://www.amb.gov.co/arte-y-creatividad-del-reciclaje-podran-apreciarse-este-viernes-en-primera-feria-al-parque/" target="_blank" rel="noreferrer">Área Metropolitana de Bucaramanga · nombre Guillermo Sorzano / San Pío ↗</a></p>
          <p><strong>Imágenes:</strong> la fotografía de portada y la galería muestran el Parque San Pío y la escultura «Mujer de pie, desnuda» con fin informativo; esta guía no afirma ni otorga una licencia de reutilización sobre esas fotografías y recomienda confirmar autoría y permisos antes de reutilizarlas. La composición geométrica original de esta guía, <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a>, se conserva en las galerías de las guías temáticas y no es una fotografía, un plano ni una representación de las instalaciones reales.</p>
        </div>
      </section>
    </main>

    <section class="section sources" id="privacidad" aria-labelledby="privacidad-title"><div class="wrap">
      <h2 id="privacidad-title">Privacidad y uso de la guía</h2>
      <p>Esta página carga Google Analytics (GA4) al abrirse para medir el uso del sitio; puede tratar identificadores, cookies y datos técnicos de conexión. El mapa integrado de Google conecta con un tercero sujeto a su propia política. Cloudflare aloja el sitio y puede tratar datos de conexión y rendimiento independientemente de Google Analytics. Consulta la <a href="https://policies.google.com/privacy">política de Google</a> y la <a href="https://www.cloudflare.com/privacypolicy/">política de Cloudflare</a>. El sitio no ofrece controles propios de consentimiento ni cuentas, reservas o formularios de contacto.</p>
      <p>El contenido es orientación editorial, no información oficial, reserva ni garantía de apertura, seguridad o disponibilidad. Confirma avisos municipales y condiciones de cada servicio. Los enlaces externos tienen sus propias condiciones; el nombre y las obras se describen con fin informativo, sin afirmar afiliación ni permiso de sus titulares.</p>
