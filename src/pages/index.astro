---
import '../styles/global.css';

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ogImageUrl = Astro.site ? new URL('/images/og-cover.png', Astro.site).toString() : undefined;

const mapUrl = 'https://maps.app.goo.gl/3t2apWjTJbkW2L4x5';
const photoHero = 'https://bucketlist2life.com/_ipx/f_webp/blogposts/bucaramanga-travel-guide/pio.jpg';
const photoPlay = 'https://i0.wp.com/www.emisoracultural.gov.co/wp-content/uploads/2023/03/PARQUE-SAN-PIO.jpeg?fit=1024%2C684&ssl=1';
const photoNight = 'https://www.bucaramanga.gov.co/wp-content/uploads/2022/09/iluminacion-parque-san-pio.jpg';

const placeSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: 'Parque San Pío',
  alternateName: 'Saint Pío Park',
  description: 'Parque urbano de Cabecera del Llano, Bucaramanga, conocido por su arbolado, senderos y la escultura Mujer de pie, desnuda de Fernando Botero.',
  ...(canonicalUrl ? { url: canonicalUrl } : {}),
  telephone: '+573184127124',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Cra. 33 #45, Cabecera del Llano',
    addressLocality: 'Bucaramanga',
    addressRegion: 'Santander',
    addressCountry: 'CO'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 7.118640815957353,
    longitude: -73.11294282307308
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: '00:00',
    closes: '23:59'
  }],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.5',
    reviewCount: '15967',
    bestRating: '5'
  },
  isAccessibleForFree: true,
  image: [photoHero, photoPlay, photoNight],
  sameAs: [mapUrl]
};

const faqItems = [
  {
    q: '¿La entrada al Parque San Pío tiene costo?',
    a: 'No. Es un espacio público de acceso libre. Actividades especiales o servicios de terceros alrededor del parque pueden tener costos propios.'
  },
  {
    q: '¿Cuál es el mejor momento para visitarlo?',
    a: 'La mañana y el final de la tarde suelen ser agradables por la sombra, la luz y el ambiente del sector. Si vas de noche, usa las precauciones habituales de una zona urbana.'
  },
  {
    q: '¿Cuánto tiempo conviene quedarse?',
    a: 'Entre 45 y 90 minutos suele bastar para caminar con calma, ver la obra de Botero, descansar bajo los árboles y combinar la visita con un café o una comida en Cabecera.'
  },
  {
    q: '¿Hay parqueadero dentro del parque?',
    a: 'El parque no funciona como estacionamiento. En las calles y manzanas cercanas hay parqueaderos privados; sus cupos, tarifas y horarios pueden cambiar, por lo que conviene confirmarlos al llegar.'
  },
  {
    q: '¿Qué obra de Fernando Botero está en San Pío?',
    a: 'La escultura se titula “Mujer de pie, desnuda”. Es una de las piezas de arte público más reconocibles de Bucaramanga y fue incorporada al patrimonio municipal en 2010.'
  },
  {
    q: '¿Se puede llegar en transporte público?',
    a: 'Sí. Cabecera es un sector bien conectado de Bucaramanga. Las rutas pueden cambiar, así que lo más fiable es consultar una app de transporte local con destino “Parque San Pío” antes de salir.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#123f33" />
    <meta name="description" content="Guía independiente del Parque San Pío en Bucaramanga: Botero, cómo llegar, horarios, costos, parqueadero, comida y lugares cercanos." />
    <title>Parque San Pío | Guía para visitar este oasis de Cabecera, Bucaramanga</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content="Parque San Pío · Bucaramanga" />
    <meta property="og:description" content="Arte, sombra y vida de barrio en el corazón de Cabecera." />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(placeSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="#inicio" aria-label="Parque San Pío, inicio">
          <img src="/icons/logo.svg" alt="Parque San Pío · Bucaramanga" width="420" height="104" />
        </a>
        <nav class="nav" aria-label="Navegación principal">
          <a href="#descubrir">Descubrir</a>
          <a href="#visita">Planear visita</a>
          <a href="#alrededores">Alrededores</a>
          <a href="#faq">Preguntas</a>
          <a class="map-link" href={mapUrl} target="_blank" rel="noreferrer">Abrir mapa ↗</a>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <section class="hero" id="inicio">
        <div class="hero-grid">
          <div>
            <div class="kicker">Cabecera · Bucaramanga</div>
            <h1>San Pío,<br />pausa verde.</h1>
            <p class="hero-lede">Un parque para caminar bajo árboles maduros, encontrarse con arte de Fernando Botero y sentir el pulso cotidiano de uno de los sectores más caminables de Bucaramanga.</p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="#visita">Planear la visita</a>
              <a class="btn btn-secondary" href={mapUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
            </div>
            <div class="hero-facts" aria-label="Datos rápidos">
              <span>★ 4,5 · 15.967 reseñas</span>
              <span>Entrada libre</span>
              <span>45–90 min sugeridos</span>
              <span>Cra. 33 con Calle 45</span>
            </div>
          </div>
          <div class="photo-composition" aria-label="Fotografías reales del Parque San Pío">
            <div class="leaf-orbit" aria-hidden="true"></div>
            <figure class="photo-main">
              <img src={photoHero} alt="Escultura Mujer de pie, desnuda de Fernando Botero en el Parque San Pío" width="1200" height="900" loading="eager" fetchpriority="high" referrerpolicy="no-referrer" />
            </figure>
            <figure class="photo-small">
              <img src={photoPlay} alt="Zona verde y juegos infantiles entre árboles del Parque San Pío" width="1024" height="684" loading="lazy" referrerpolicy="no-referrer" />
            </figure>
            <div class="botero-badge">Arte público<br />+ ciudad jardín</div>
          </div>
        </div>
      </section>

      <section class="section identity" id="descubrir">
        <div class="wrap">
          <div class="section-heading">
            <div>
              <div class="kicker" style="color:var(--gold)">La identidad del parque</div>
              <h2>Donde el verde conversa con el bronce.</h2>
            </div>
            <p>San Pío no necesita grandes monumentos ni recorridos rígidos: su carácter está en la escala humana, la sombra, los caminos de ladrillo y el contraste entre naturaleza urbana y arte público.</p>
          </div>
          <div class="story-grid">
            <article class="story-feature">
              <div class="number">2010</div>
              <h3>Botero en el espacio cotidiano</h3>
              <p>Ese año el municipio incorporó la escultura <em>Mujer de pie, desnuda</em>, de Fernando Botero. La pieza se volvió un punto de referencia visual y cultural del parque y ha recibido intervenciones de conservación patrimonial.</p>
            </article>
            <div class="story-stack">
              <article class="story-card">
                <h3>Más jardín, menos prisa</h3>
                <p>Una intervención de paisajismo reportada por la Alcaldía incluyó la siembra de más de 3.000 plantas ornamentales y el mejoramiento del entorno de la escultura de mariposa de Mario Hernández.</p>
              </article>
              <article class="story-card">
                <h3>Senderos para volver a caminar</h3>
                <p>La recuperación del parque incorporó iluminación LED, restauración de más de 1.000 m² de senderos y mejoras posteriores en juegos, accesos peatonales y mobiliario urbano.</p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="visita">
        <div class="wrap">
          <div class="section-heading">
            <div>
              <div class="kicker">Antes de salir</div>
              <h2>Una visita sencilla de organizar.</h2>
            </div>
            <p>San Pío funciona mejor como una pausa dentro de un recorrido por Cabecera: combina el parque con una comida, café o paseo por las calles comerciales cercanas.</p>
          </div>
          <div class="visit-grid">
            <article class="visit-item">
              <div class="icon" aria-hidden="true">◌</div>
              <h3>Entrada / costo</h3>
              <p>Acceso libre al parque. No hay boleto de entrada. Actividades especiales o servicios privados pueden cobrar por separado.</p>
            </article>
            <article class="visit-item">
              <div class="icon" aria-hidden="true">☀</div>
              <h3>Mejor momento</h3>
              <p>Mañana o final de la tarde para aprovechar sombra, luz suave y movimiento del sector sin el sol más intenso.</p>
            </article>
            <article class="visit-item">
              <div class="icon" aria-hidden="true">⌁</div>
              <h3>Tiempo sugerido</h3>
              <p>45–90 minutos para una vuelta tranquila, fotografías, descanso y una mirada atenta a las esculturas.</p>
            </article>
            <article class="visit-item">
              <div class="icon" aria-hidden="true">24</div>
              <h3>Acceso</h3>
              <p>El espacio público figura con acceso continuo. Mantenimiento, eventos o cierres operativos pueden afectar zonas puntuales.</p>
            </article>
          </div>
          <p class="note"><strong>Consejo local:</strong> Bucaramanga tiene clima cálido; lleva agua y protección solar aunque el parque sea sombreado. Para la noche, aplica las precauciones normales de cualquier espacio público urbano.</p>
        </div>
      </section>

      <section class="gallery-band" aria-label="Galería del parque">
        <div class="wrap gallery-grid">
          <figure>
            <img src={photoNight} alt="Vista nocturna iluminada del Parque San Pío" width="1600" height="900" loading="lazy" referrerpolicy="no-referrer" />
            <figcaption>Iluminación del parque · foto de prensa de la Alcaldía de Bucaramanga</figcaption>
          </figure>
          <figure>
            <img src={photoPlay} alt="Juegos infantiles y vegetación del Parque San Pío" width="1024" height="684" loading="lazy" referrerpolicy="no-referrer" />
            <figcaption>Vida de parque bajo el dosel urbano</figcaption>
          </figure>
        </div>
      </section>

      <section class="section" id="movilidad">
        <div class="wrap">
          <div class="section-heading">
            <div>
              <div class="kicker">Movilidad</div>
              <h2>Llegar, caminar, estacionar.</h2>
            </div>
            <p>El parque está en Cabecera del Llano, entre corredores urbanos activos. La forma más cómoda depende de dónde comiences tu recorrido y de la hora.</p>
          </div>
          <div class="info-split">
            <article class="info-panel">
              <h3>Cómo llegar</h3>
              <ul>
                <li><strong>A pie:</strong> una buena opción si ya estás en Cabecera; las cuadras cercanas concentran comercio, restaurantes y cafés.</li>
                <li><strong>Taxi o app:</strong> usa “Parque San Pío” o la dirección Cra. 33 #45 como destino.</li>
                <li><strong>Bus:</strong> el sector cuenta con transporte urbano; consulta la ruta vigente el mismo día porque recorridos y paradas pueden cambiar.</li>
                <li><strong>Bicicleta:</strong> llega con precaución por vías urbanas y asegura la bicicleta únicamente en un punto permitido.</li>
              </ul>
            </article>
            <article class="info-panel">
              <h3>Parqueadero</h3>
              <ul>
                <li>El parque en sí no es un estacionamiento.</li>
                <li>Hay parqueaderos privados en las manzanas de Cabecera; uno de los puntos señalados en directorios locales está en el entorno de la Cra. 35A con Calle 45.</li>
                <li>No se publican aquí tarifas exactas porque cambian con frecuencia: confirma precio, horario y cupo al llegar.</li>
                <li>Evita dejar objetos visibles dentro del vehículo y respeta las restricciones de estacionamiento en vía.</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section class="section map-section" id="mapa">
        <div class="wrap map-shell">
          <div class="map-copy">
            <div class="kicker">Ubicación</div>
            <h2>En el corazón de Cabecera.</h2>
            <address>Cra. 33 #45<br />Cabecera del Llano<br />Bucaramanga, Santander, Colombia</address>
            <p class="coords">7.118641, −73.112943 · Plus Code 4V9Q+FV</p>
            <a class="btn btn-primary" href={mapUrl} target="_blank" rel="noreferrer">Abrir en Google Maps ↗</a>
          </div>
          <div class="map-frame">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7036.616756437815!2d-73.11294282307308!3d7.118640815957353!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e683fe064f93ebf%3A0xbc42f072c47c5ffa!2sSaint%20P%C3%ADo%20Park!5e1!3m2!1ses-419!2sco!4v1789089993252!5m2!1ses-419!2sco"
              title="Mapa de Parque San Pío, Bucaramanga"
              loading="lazy"
              allowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"></iframe>
          </div>
        </div>
      </section>

      <section class="section" id="alrededores">
        <div class="wrap">
          <div class="section-heading">
            <div>
              <div class="kicker">Alrededores</div>
              <h2>Comer bien y seguir caminando.</h2>
            </div>
            <p>Cabecera permite convertir una visita corta al parque en una tarde completa. Estas opciones están en el entorno del sector; verifica horarios y disponibilidad antes de ir.</p>
          </div>
          <h3 style="font-size:2rem;margin:0 0 1rem">Para comer cerca</h3>
          <div class="local-grid">
            <article class="local-item"><div class="local-index">01</div><div><h3>Mercagán Parrilla San Pío</h3><p>Parrilla santandereana y carnes; una opción cercana para convertir el paseo en almuerzo o cena.</p></div></article>
            <article class="local-item"><div class="local-index">02</div><div><h3>Crepes & Waffles</h3><p>Alternativa casual junto al entorno de San Pío, útil para una comida ligera o postre.</p></div></article>
            <article class="local-item"><div class="local-index">03</div><div><h3>Cafetopía</h3><p>Café de especialidad en Cabecera para hacer una pausa antes o después del parque.</p></div></article>
            <article class="local-item"><div class="local-index">04</div><div><h3>San Marzano</h3><p>Cocina italiana y pizza en las calles inmediatas del sector.</p></div></article>
          </div>

          <h3 style="font-size:2rem;margin:3.2rem 0 1rem">Otros lugares para enlazar</h3>
          <div class="local-grid">
            <article class="local-item"><div class="local-index">A</div><div><h3>Parque Las Palmas</h3><p>Otra pequeña pausa verde de Cabecera, rodeada de cafés y restaurantes.</p></div></article>
            <article class="local-item"><div class="local-index">B</div><div><h3>Parque Ecológico La Flora</h3><p>Una opción con sensación más natural para quien quiera ampliar la dosis de verde urbano.</p></div></article>
            <article class="local-item"><div class="local-index">C</div><div><h3>Parque Carlos Enrique Virviescas</h3><p>Espacio barrial conocido también como Parque de los Perros, frecuentado para caminar y encontrarse.</p></div></article>
            <article class="local-item"><div class="local-index">D</div><div><h3>Parque de los Niños</h3><p>Un parque urbano de mayor escala que puede complementar un recorrido por otros sectores de Bucaramanga.</p></div></article>
          </div>
        </div>
      </section>

      <section class="section faq" id="faq">
        <div class="wrap">
          <div class="section-heading">
            <div>
              <div class="kicker" style="color:var(--gold)">FAQ</div>
              <h2>Preguntas antes de ir.</h2>
            </div>
            <p>Respuestas breves para planear sin sobrecargar la visita. Cuando un dato operativo puede cambiar, conviene confirmarlo el mismo día.</p>
          </div>
          <div>
            {faqItems.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="section sources" aria-labelledby="fuentes-title">
        <div class="wrap">
          <h2 id="fuentes-title" style="font-size:2.2rem;color:var(--forest-deep)">Fuentes y criterio editorial</h2>
          <p>La información cultural y de mejoras del parque se contrastó con publicaciones de la Alcaldía de Bucaramanga y del Instituto Municipal de Cultura y Turismo. Los datos operativos de comercios, transporte y parqueaderos cambian con mayor frecuencia; por eso esta guía evita fijar tarifas, rutas u horarios de terceros que puedan quedar obsoletos.</p>
          <p>
            <a href="https://www.bucaramanga.gov.co/noticias/parque-san-pio-respira-un-nuevo-aire/" target="_blank" rel="noreferrer">Paisajismo y recuperación del Parque San Pío ↗</a><br />
            <a href="https://www.bucaramanga.gov.co/noticias/inicio-la-restauracion-de-la-gorda-botero-en-san-pio/" target="_blank" rel="noreferrer">Conservación de “Mujer de pie, desnuda” ↗</a><br />
            <a href="https://www.bucaramanga.gov.co/noticias/el-parque-san-pio-se-reabre-por-completo-asi-lo-disfrutan-de-nuevo-los-bumangueses/" target="_blank" rel="noreferrer">Senderos, iluminación y espacio público ↗</a>
          </p>
          <p><strong>Créditos de fotografía:</strong> Alcaldía de Bucaramanga / Diego Calderón (imagen nocturna); La Cultural FM (zona de juegos); Bucketlist2life (vista de la escultura). Las fotografías se cargan desde sus fuentes originales porque este entorno de entrega no permite redistribuir de forma segura archivos fotográficos de terceros.</p>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <img src="/icons/logo.svg" alt="Parque San Pío" width="420" height="104" loading="lazy" />
        <small>Sitio informativo independiente. No es el sitio oficial del Parque San Pío, de la Alcaldía de Bucaramanga ni de ninguna entidad pública o comercio mencionado.</small>
      </div>
    </footer>
  </body>
</html>
